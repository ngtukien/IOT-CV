# Copy file này thành .env rồi sửa theo môi trường của bạn. .env KHÔNG được commit.

# ---------------------------------------------------------------------------
# MAVLink
# ---------------------------------------------------------------------------
# ┌─ LỖI SỐ MỘT CỦA NGƯỜI MỚI: nhầm chiều UDP ────────────────────────────┐
# │ udpin:  backend NGỒI CHỜ ở cổng này  <- gần như luôn là cái bạn muốn   │
# │ udpout: backend GÕ CỬA tới cổng này                                   │
# │                                                                        │
# │ SITL chạy `--out=udp:127.0.0.1:14551` nghĩa là MAVProxy GỬI TỚI 14551, │
# │ nên backend phải LẮNG NGHE: udpin:127.0.0.1:14551                     │
# │ (`udp:` trong pymavlink cũng mặc định là lắng nghe, nhưng ghi rõ       │
# │  `udpin:` thì không ai phải đoán.)                                    │
# └────────────────────────────────────────────────────────────────────────┘
#
# SITL một mình (Phase 02):        udpin:127.0.0.1:14550
# SITL + Mission Planner song song: udpin:127.0.0.1:14551
#   (SITL chẻ hai cổng: --out=udp:127.0.0.1:14550 --out=udp:127.0.0.1:14551
#    rồi Mission Planner nối 14550, backend nối 14551. Chung một cổng thì
#    hai bên đá nhau.)
# Drone thật qua ESP32 bridge (GIAI ĐOẠN 59): udpin:0.0.0.0:14550
# USB trực tiếp: /dev/ttyACM0 hoặc /dev/ttyUSB0
MAVLINK_ENDPOINT=udp:127.0.0.1:14550
MAVLINK_BAUD=115200

# "Số nhà" của backend trên mạng MAVLink (Phase 05).
# Mission Planner dùng 255 — backend PHẢI khác, nếu không COMMAND_ACK của
# flight controller không phân biệt được ai hỏi khi chạy song song hai GCS.
MAVLINK_SOURCE_SYSTEM=254
MAVLINK_SOURCE_COMPONENT=190

# Không nhận message MAVLink nào trong chừng này giây = coi như mất link.
LINK_TIMEOUT_S=3
# Chờ heartbeat đầu tiên tối đa bao lâu khi mở link.
HEARTBEAT_TIMEOUT_S=10

# ---------------------------------------------------------------------------
# Backend web
# ---------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Tần số push telemetry qua WebSocket (GIAI ĐOẠN 7: 5-10 Hz là đủ cho UI)
TELEMETRY_HZ=8

# ---------------------------------------------------------------------------
# Giới hạn an toàn phần mềm (GIAI ĐOẠN 14) — giới hạn của project, không phải
# giới hạn kỹ thuật của ArduPilot. Lớp authoritative vẫn là geofence trên FC.
# ---------------------------------------------------------------------------
MAX_ALT=10
MIN_ALT=2
MAX_DISTANCE_HOME=50
MAX_WAYPOINTS=10
# Vận tốc tối đa cho manual control qua web (GIAI ĐOẠN 64: bắt đầu 0.5 m/s)
MAX_VELOCITY=1.0
# Dead-man timeout cho WASD (GIAI ĐOẠN 11)
MANUAL_COMMAND_TIMEOUT_MS=300
# Vòng dead-man (Phase 06) quét mỗi chừng này ms. Phải NHỎ HƠN HẲN
# MANUAL_COMMAND_TIMEOUT_MS, nếu không timeout 300 ms thành 300+tick ms.
DEADMAN_TICK_MS=50
# Bảo đảm THẬT của hệ thống là MANUAL_COMMAND_TIMEOUT_MS + DEADMAN_TICK_MS
# = 350 ms, không phải 300 ms. 300 là ngưỡng HẾT HẠN, 350 là ngưỡng GIAO HÀNG.
# Đường đóng-socket nhanh hơn nhiều (đo thật: < 1 ms) vì nó không chờ hết hạn.
#
# Một lần dead-man nổ thì gửi (0,0,0) bao nhiêu nhịp liên tiếp. MAVLink chạy
# trên UDP: một gói rơi là lệnh dừng biến mất không dấu vết.
ZERO_VELOCITY_REPEAT=5
# Chờ COMMAND_ACK của flight controller tối đa bao lâu (mode / arm / takeoff).
COMMAND_ACK_TIMEOUT_S=3.0
# Sổ kiểm mỗi lần gửi zero-velocity. HỢP ĐỒNG với Phase 10 §10.7: test
# Playwright đọc chính file này để đo độ trễ dead-man.
DEADMAN_LOG_PATH=logs/deadman.jsonl
# Tốc độ xoay tối đa, ĐỘ/GIÂY. Có khoá RIÊNG vì MAX_VELOCITY tính bằng m/s —
# dùng chung một hằng số cho hai đơn vị là kẹp yaw xuống 1 độ/giây, tức là
# xoay nửa vòng mất ba phút, và không có gì báo lỗi.
MAX_YAW_RATE=45

# Tránh vật cản (Phase 07). Khai báo sẵn từ Phase 05 vì hợp đồng WebSocket nói
# UI đọc MỌI ngưỡng từ `limits` — Phase 08 dựng UI trước khi Phase 07 xong.
AVOID_MARGIN_M=2.0
AVOID_DIST_MAX_M=5.0
RANGEFINDER_MAX_M=6.0
# Số đo cũ hơn chừng này (giây) thì avoid_state = UNKNOWN — đang mù, KHÁC "trống".
PROXIMITY_STALE_S=2.0

# Mission protocol (Phase 07). Chờ mỗi MISSION_REQUEST bao lâu, gửi lại
# MISSION_COUNT mấy lần; sai số alt khi so mission đọc lại.
MISSION_ITEM_TIMEOUT_S=2.0
MISSION_RETRIES=3
MISSION_READBACK_ALT_TOL_M=0.1
# Pin dưới ngưỡng này (%) thì CẢNH BÁO. Backend không bao giờ tự RTL.
BATTERY_WARN_PCT=25

# ---------------------------------------------------------------------------
# Vision
# ---------------------------------------------------------------------------
CAMERA_STREAM_URL=http://192.168.4.1:81/stream
YOLO_WEIGHTS=ml/weights/yolo11n.pt
DETECTION_CONFIDENCE=0.6
# Chống spam detection (GIAI ĐOẠN 75)
DETECTION_MIN_FRAMES=3
DETECTION_COOLDOWN_S=4
# "0" = GPU 0, "cpu" để ép chạy CPU (AI Phase 1 §A1.9)
YOLO_DEVICE=0
DETECTION_IMGSZ=640
# Đặt 0/false để tắt hẳn khối vision — dùng khi test bay, cho máy đỡ tải.
VISION_ENABLED=1
# Nguồn video GIẢ (Phase 07): 1 = backend tự phát lại video mẫu qua
# /api/video/fake-source và bỏ qua CAMERA_STREAM_URL; 0 = đọc camera thật.
CAMERA_FAKE=1
CAMERA_FAKE_CLIP=backend/vision/assets/sample-clip.mp4
CAMERA_FAKE_FPS=15
# Cỡ khung của nguồn giả: QVGA (320x240, mốc thiết kế ESP32) | VGA (640x480,
# mặc định, dễ xem) | SVGA (800x600). Chất lượng JPEG theo thang esp32 0-63,
# SỐ NHỎ = NÉT HƠN.
CAMERA_FAKE_FRAMESIZE=VGA
CAMERA_FAKE_JPEG_QUALITY=10
FAKE_DETECTION_INTERVAL_MS=300
# Khung mới nhất cũ hơn chừng này (giây) thì camera coi như mất.
CAMERA_STALE_S=2.0

# ---------------------------------------------------------------------------
# MQTT (GIAI ĐOẠN 76)
# ---------------------------------------------------------------------------
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID=uav-gcs
