# ---------------------------------------------------------------------------
# ArduPilot source (dùng làm công cụ SITL, KHÔNG phải code của dự án)
# Clone riêng theo docs/dev-env.md — không commit vào repo này.
# ---------------------------------------------------------------------------
/ardupilot/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.venv-*/
venv/
venv-*/
env/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Secrets / cấu hình cục bộ
# ---------------------------------------------------------------------------
.env
.env.local
*.local.yml

# ---------------------------------------------------------------------------
# Machine learning: dataset và weights KHÔNG commit (dung lượng lớn).
# Giữ lại cấu trúc thư mục bằng .gitkeep.
# ---------------------------------------------------------------------------
ml/datasets/*
!ml/datasets/.gitkeep
# DVC (AI Phase 1, A1.8) phien ban-hoa ml/datasets/ bang con tro .dvc. Dong
# "ml/datasets/*" o tren loai ca con tro lan file .gitignore rieng cua DVC, nen
# phai mo lai hai thu do — chung la METADATA, khong phai du lieu.
!ml/datasets/*.dvc
!ml/datasets/.gitignore
ml/weights/*
!ml/weights/.gitkeep
ml/results/*
!ml/results/.gitkeep
runs/
*.pt
*.onnx
*.engine

# ---------------------------------------------------------------------------
# Flight log / telemetry / ảnh detection
# Giữ lại cấu trúc thư mục nhưng không commit dữ liệu bay.
# ---------------------------------------------------------------------------
logs/*
!logs/.gitkeep
detections/
snapshots/
*.BIN
*.bin
*.tlog
*.tlog.raw
*.log

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
node_modules/

# ---------------------------------------------------------------------------
# ESP32 / PlatformIO / Arduino build
# ---------------------------------------------------------------------------
.pio/
esp32/**/build/

# ---------------------------------------------------------------------------
# IDE / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
.claude
.codex
.agents
.playwright-mcp
tmp

# ---------------------------------------------------------------------------
# Firmware ArduPilot: nhi phan tai ve / build ra -> KHONG commit.
# Tai lai bat cu luc nao tu custom.ardupilot.org bang dung file
# firmware/ardupilot/custombuild/*.yaml
# ---------------------------------------------------------------------------
firmware/ardupilot/**/*.hex
firmware/ardupilot/**/*.apj
firmware/ardupilot/**/*.elf
firmware/ardupilot/**/arducopter
copter-speedybeef4v5-d450a747.tar.gz

# build.log cua custom build PHAI duoc commit: no la bang chung feature da build
# dung y (PRX_*, OAPATHPLANNER, TFMINIPLUS...). Dong "!" nay PHAI nam SAU dong
# "*.log" o phia tren, neu khong git van bo qua file.
!firmware/ardupilot/**/build.log
